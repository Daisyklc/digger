# Copy to .env and adjust. These configure the cloud server.

# --- ASR ---
# Path produced by scripts/prepare_model.py (CTranslate2 format).
ASR_MODEL=models/anime-whisper-ct2
DEVICE=cuda
# float16 fits ~16 GB. Use int8_float16 if you are tight on VRAM.
COMPUTE_TYPE=float16
ASR_LANGUAGE=ja
BEAM_SIZE=5
VAD_FILTER=true

# --- Translation (local NLLB, offline & uncensored) ---
ENABLE_TRANSLATION=true
# distilled-1.3B is a good quality/VRAM balance on 16 GB.
# Use facebook/nllb-200-distilled-600M to save memory.
NLLB_MODEL=facebook/nllb-200-distilled-1.3B
SOURCE_LANG=jpn_Jpan
TARGET_LANG=zho_Hans
TRANSLATE_BATCH_SIZE=16

# --- Service ---
# Set a long random token; clients must send it as a bearer token.
API_KEY=
WORK_DIR=/tmp/drama_asr_jobs
DELETE_AUDIO_AFTER=true
JOB_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=2147483648

# --- Testing only ---
# MOCK=1 replaces the models with stubs so the API runs without a GPU.
MOCK=0
