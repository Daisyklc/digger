{
  "manifest_version": 3,
  "name": "WebTranslator — 电子书/漫画沉浸翻译",
  "version": "0.1.0",
  "description": "网页端电子书与在线漫画的沉浸式翻译: 文本原位替换 + 漫画气泡贴字。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebTranslator"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
